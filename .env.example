# AutoML-Agent backend configuration (copy to .env and fill in).
#
# Choose which backend the pipeline uses. One of: gemini | groq | openrouter | ollama
AMLA_LLM=gemini

# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Groq (free tier: https://console.groq.com/keys) ------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (free key: https://openrouter.ai/keys) ----------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# --- Ollama (local endpoint; cloud models need `ollama signin`) -------------
# For cloud models: `ollama pull gpt-oss:120b-cloud`
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_API_KEY=ollama

# --- Optional / unused for the local-dataset run ----------------------------
OPENAI_API_KEY=
HF_TOKEN=
SERPAPI_KEY=
TAVILY_API_KEY=
PWC_KEY=
